rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la cuenta administradora (la misma de admin-auth.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'viejitojohn@gmail.com';
    }

    // Distribuidores autorizados: el documento se llama como su correo (en minúsculas).
    function esDistribuidor() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/distribuidores/$(request.auth.token.email.lower()));
    }

    // Pedidos: cualquier visitante puede crear uno desde el checkout,
    // pero solo el administrador puede leerlos o modificarlos.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['producto', 'nombre', 'telefono', 'direccion'])
        && request.resource.data.producto is string && request.resource.data.producto.size() < 200
        && request.resource.data.nombre is string && request.resource.data.nombre.size() < 200
        && request.resource.data.telefono is string && request.resource.data.telefono.size() < 50
        && request.resource.data.direccion is string && request.resource.data.direccion.size() < 500
        // Un pedido a precio distribuidor solo lo puede crear un distribuidor autorizado
        && (request.resource.data.get('nivelPrecio', '') != 'distribuidores'
            || (esDistribuidor() && request.resource.data.get('distribuidorCorreo', '') == request.auth.token.email.lower()));
      allow read, update, delete: if isAdmin();
    }

    // Precios y cronómetro de oferta: los ve cualquiera (inicio, catálogo, checkout),
    // pero solo el administrador los cambia.
    match /preciosMenudeo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preciosMayoreo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Catálogo de productos (nombre, imagen, video, precios): lo ve cualquiera, solo el administrador lo edita.
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de distribuidores: cada uno solo puede leer su propio registro; solo el administrador la edita.
    match /distribuidores/{correo} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email != null && correo == request.auth.token.email.lower());
      allow write: if isAdmin();
    }
    // Precio de distribuidor: privado. Solo lo leen los distribuidores autorizados y el administrador.
    match /preciosDistribuidor/{id} {
      allow read: if isAdmin() || esDistribuidor();
      allow write: if isAdmin();
    }

    // Seguimiento del pedido: el cliente consulta SOLO con su número de pedido (no se puede listar).
    // Guarda únicamente estado, paquetería, guía y fechas: nunca nombre, teléfono ni dirección.
    match /seguimiento/{codigo} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (codigo.matches('VJ-[A-Z0-9]{8}')
            && request.resource.data.keys().hasOnly(['codigo', 'estado', 'fecha'])
            && request.resource.data.codigo == codigo
            && request.resource.data.estado == 'nuevo');
    }

    // Todo lo demás (inventario, fórmulas, ventas, mayoristas, auditoría, etc.): solo el administrador
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
