rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo la cuenta administradora (la misma de admin-auth.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'viejitojohn@gmail.com';
    }

    // Cuentas con precio especial (mayorista, medio mayorista, distribuidor, cambaceo):
    // el documento se llama como su correo (en minúsculas) y trae el campo "nivel".
    // Las cuentas anteriores sin "nivel" cuentan como distribuidor.
    function tieneCuenta() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/distribuidores/$(request.auth.token.email.lower()));
    }
    function nivelCuenta() {
      return get(/databases/$(database)/documents/distribuidores/$(request.auth.token.email.lower())).data.get('nivel', 'distribuidores');
    }
    // Compra mínima por pedido de un nivel (config/niveles, campo minimoCompra); 0 si no está definida
    function minimoNivel(n) {
      return exists(/databases/$(database)/documents/config/niveles)
        && (n in get(/databases/$(database)/documents/config/niveles).data)
        && get(/databases/$(database)/documents/config/niveles).data[n].get('minimoCompra', 0) is number
        ? get(/databases/$(database)/documents/config/niveles).data[n].get('minimoCompra', 0) : 0;
    }
    function esDistribuidor() {
      return tieneCuenta() && nivelCuenta() == 'distribuidores';
    }

    // Pedidos: cualquier visitante puede crear uno desde el checkout,
    // pero solo el administrador puede leerlos o modificarlos.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['producto', 'nombre', 'telefono', 'direccion'])
        && request.resource.data.producto is string && request.resource.data.producto.size() < 200
        && request.resource.data.nombre is string && request.resource.data.nombre.size() < 200
        && request.resource.data.telefono is string && request.resource.data.telefono.size() < 50
        && request.resource.data.direccion is string && request.resource.data.direccion.size() < 500
        // Un pedido con precio especial solo lo puede crear la cuenta autorizada de ese mismo nivel
        && (request.resource.data.get('nivelPrecio', 'publico') == 'publico'
            || (tieneCuenta() && nivelCuenta() == request.resource.data.get('nivelPrecio', '')
                && request.resource.data.get('distribuidorCorreo', '') == request.auth.token.email.lower()
                && request.resource.data.get('subtotalNumero', 0) >= minimoNivel(request.resource.data.get('nivelPrecio', ''))));
      allow read, update, delete: if isAdmin();
    }

    // Precios y cronómetro de oferta: los ve cualquiera (inicio, catálogo, checkout),
    // pero solo el administrador los cambia.
    match /preciosMenudeo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preciosMayoreo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Catálogo de productos (nombre, imagen, video, precios): lo ve cualquiera, solo el administrador lo edita.
    match /productos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de distribuidores: cada uno solo puede leer su propio registro; solo el administrador la edita.
    match /distribuidores/{correo} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email != null && correo == request.auth.token.email.lower());
      allow write: if isAdmin();
    }
    // Precio de distribuidor: privado. Solo lo leen los distribuidores autorizados y el administrador.
    match /preciosDistribuidor/{id} {
      allow read: if isAdmin() || esDistribuidor();
      allow write: if isAdmin();
    }

    // Precios de mayorista, medio mayorista y cambaceo: privados por nivel.
    // Cada cuenta solo lee los precios de SU nivel; solo el administrador los escribe.
    match /preciosNivel/{nivel}/items/{id} {
      allow read: if isAdmin() || (tieneCuenta() && nivelCuenta() == nivel);
      allow write: if isAdmin();
    }

    // Seguimiento del pedido: el cliente consulta SOLO con su número de pedido (no se puede listar).
    // Guarda únicamente estado, paquetería, guía y fechas: nunca nombre, teléfono ni dirección.
    match /seguimiento/{codigo} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if isAdmin()
        || (codigo.matches('VJ-[A-Z0-9]{8}')
            && request.resource.data.keys().hasOnly(['codigo', 'estado', 'fecha'])
            && request.resource.data.codigo == codigo
            && request.resource.data.estado == 'nuevo');
    }

    // Todo lo demás (inventario, fórmulas, ventas, mayoristas, auditoría, etc.): solo el administrador
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
